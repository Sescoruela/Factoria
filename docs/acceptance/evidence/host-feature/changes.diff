+import unittest
+
+from app import count_even
+
+
+class CountEvenTests(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(count_even([]), 0)
+
+    def test_mixed(self):
+        self.assertEqual(count_even([1, 2, 4, -2, 0]), 4)
+
+    def test_negatives(self):
+        self.assertEqual(count_even([-3, -2, -1]), 1)
+
+    def test_zeroes(self):
+        self.assertEqual(count_even([0, 0]), 2)
